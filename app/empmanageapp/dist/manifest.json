{
	"_version": "1.76.0",
	"sap.app": {
		"id": "com.demo.employee.empmanageapp",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.20.0",
			"toolsId": "164c7b9c-c9bb-4694-a3d0-e51f7afb3bf9"
		},
		"dataSources": {
			"mainService": {
				"uri": "odata/v4/books-odata/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.0"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"empmanageapp-display": {
					"semanticObject": "empmanageapp",
					"action": "display",
					"title": "Employee App",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.143.2",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.demo.employee.empmanageapp.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "EmployeesList",
					"target": "EmployeesList"
				},
				{
					"pattern": "Employees({key}):?query:",
					"name": "EmployeesObjectPage",
					"target": "EmployeesObjectPage"
				},
				{
					"name": "Employees_familyMembersObjectPage",
					"pattern": "Employees({key})/familyMembers({familyMembersKey}):?query:",
					"target": "Employees_familyMembersObjectPage"
				}
			],
			"targets": {
				"EmployeesList": {
					"type": "Component",
					"id": "EmployeesList",
					"name": "sap.fe.templates.ListReport",
					"options": {
						"settings": {
							"contextPath": "/Employees",
							"variantManagement": "Page",
							"navigation": {
								"Employees": {
									"detail": {
										"route": "EmployeesObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "GridTable"
									}
								}
							}
						}
					}
				},
				"EmployeesObjectPage": {
					"type": "Component",
					"id": "EmployeesObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Employees",
							"sectionLayout": "Tabs",
							"navigation": {
								"familyMembers": {
									"detail": {
										"route": "Employees_familyMembersObjectPage"
									}
								}
							},
							"content": {
								"header": {
									"actions": {
										"customAction": {
											"press": "com.demo.employee.empmanageapp.ext.controller.ActionHandler.onUpdateStatus",
											"visible": "{= !${ui>/isEditable}}",
											"enabled": true,
											"text": "Update Status",
											"position": {
												"placement": "Before",
												"anchor": "EditAction"
											}
										}
									}
								}
							}
						}
					}
				},
				"Employees_familyMembersObjectPage": {
					"type": "Component",
					"id": "Employees_familyMembersObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"navigation": {},
							"contextPath": "/Employees/familyMembers"
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.cloud": {
		"public": true,
		"service": "firstcapproject.service"
	}
}