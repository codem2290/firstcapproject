PROCEDURE "BASICPRODE"( 
    OUT DEPARTMENT_DATA TABLE (CODE VARCHAR(255), DESCRIPTION VARCHAR(255)),
    OUT DESIGNATION_DATA TABLE (CODE VARCHAR(255), DESCRIPTION VARCHAR(255))
)
   LANGUAGE SQLSCRIPT
   SQL SECURITY INVOKER
   --DEFAULT SCHEMA <default_schema_name>
   READS SQL DATA AS
BEGIN
   /*************************************
       Write your procedure logic
   *************************************/
    DEPARTMENT_DATA  = SELECT "CODE" as CODE, "DESCRIPTION" as DESCRIPTION FROM "COM_SAP_TABLES_DEPARTMENTS";
     DESIGNATION_DATA  = SELECT "CODE" as CODE, "DESCRIPTION" as DESCRIPTION FROM "COM_SAP_TABLES_DESIGNATION";

END